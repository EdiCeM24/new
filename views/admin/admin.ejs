            Create Products
          </h1>
          <form
            action=""
            class="w-full flex items-center flex-col justify-center gap-4"
            method="post"
            enctype="multipart/form-data"
          >
            <div class="flex items-center justify-evenly gap-2">
              <input
                type="hidden"
                name=""
                id=""
                autocomplete="off"
                autofocus
                placeholder=""
              />
              <input
                type="file"
                name="image"
                id="image"
                class="w-[70%] outline-none border-none bg-green-50 p-2 text-slate-950 rounded-sm"
                autocomplete="off"
                autofocus
                placeholder="Product Image"
              />
            </div>
            <div class="flex items-center justify-evenly gap-2">
              <input
                type="text"
                name="name"
                class="outline-none border-none bg-green-50 p-2 text-slate-950 rounded-sm"
                id="title"
                autocomplete="off"
                autofocus
                placeholder="Product Name"
              />
              <input
                type="number"
                name="price"
                class="outline-none border-none bg-green-50 p-2 text-slate-950 rounded-sm"
                id="price"
                autocomplete="off"
                autofocus
                placeholder="Price"
              />
            </div>
            <div class="flex items-center justify-evenly gap-5">
              <input
                type="number"
                name="stock"
                class="outline-none border-none bg-green-50 p-2 text-slate-950 rounded-sm"
                id="stock"
                autocomplete="off"
                autofocus
                placeholder="Stock"
              />
              <textarea
                type="text"
                name="desc"
                class="outline-none border-none bg-green-50 p-2 text-slate-950 rounded-sm"
                id="desc"
                autocomplete="off"
                autofocus
                placeholder="Product description"
              ></textarea>
            </div>
            <div class="flex items-center justify-between gap-5">
              <select
                name=""
                id=""
                type="number"
                name="size"
                class="outline-none border-none bg-green-50 p-2 text-slate-950 rounded-sm"
                id="size"
                autocomplete="off"
                autofocus
                placeholder="Size"
              >
                <option>sizes</option>
                <option>sm</option>
                <option>m</option>
                <option>L</option>
                <option>XL</option>
                <option>XXL</option>
