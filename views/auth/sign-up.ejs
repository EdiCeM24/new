<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%- title %></title>
    <link rel="stylesheet" href="/css/output.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
      integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
  </head>
  <body>
    <main class="">
      <section class="">
        <div class="">
          <div class="">
            <strong>Welcome!</strong>
            <p>Please create your account.</p>
          </div>

          <div class="">
            <form action="" method="post" enctype="multipart/form-data">
              <input type="hidden" name="" id="" />
              <div class="">
                <!--Social Media Accounts and Profile-->
                <span class=""></span>
                <span>
                  <input
                    type="file"
                    class=""
                    name="profile"
                    id="profile"
                    placeholder=""
                  />
                </span>
              </div>
              <div class="">
                <input
                  type="text"
                  class=""
                  name="name"
                  id="name"
                  placeholder="Enter full name..."
                  autocomplete="off"
                  autofocus
                />
                <input
                  type="text"
                  class=""
                  name="username"
                  id="username"
                  placeholder="Enter username..., e.g., Donatus123@ or ..."
                  autocomplete="off"
                  autofocus
                />
              </div>
              <div class="">
                <input
                  type="email"
                  class=""
                  name="email"
                  id="email"
                  placeholder="Enter email: donatus@gmail.com"
                  autocomplete="off"
                  autofocus
                />
                <input
                  type="password"
                  class=""
                  name="password"
                  id="password"
                  placeholder="Enter password: Password123@ or ..."
                  autocomplete="off"
                  autofocus
                />
              </div>
              <div class="">
                <input
                  type="radio"
                  class=""
                  name="male"
                  id="sex"
                  autocomplete="off"
                  autofocus
                />
                <input
                  type="radio"
                  class=""
                  name="female"
                  id="female"
                  autocomplete="off"
                  autofocus
                />
                <input
                  type="radio"
                  class=""
                  name="other"
                  id="other"
                  autocomplete="off"
                  autofocus
                />
              </div>
              <div class="">
                <button type="submit" class="">Register</button>
              </div>
              <div class="flex items-center justify-center">
                <input
                  type="checkbox"
                  name="isActive"
                  id="is-active"
                  class=""
                />
                <span class="flex items-center justify-evenly">
                  <span class=""
                    >By clicking on the checkbox you have agreed to our</span
                  >
                  <a href="" class="">Term of use</a> <span class="">and</span>
                  <a href="" class="">Privacy policy</a>
                </span>
              </div>
            </form>
          </div>
          <p id="captcha"></p>
        </div>
      </section>
    </main>
    <footer><%- include('../incudes/footer.ejs') %></footer>
    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
  </body>
</html>
